      "parameters": [{ "name": "type", "value": "EXPENSE", "disabled": true }],
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_categories_create",
      "parentId": "grp_categories",
      "name": "Criar categoria",
      "method": "POST",
      "url": "{{ _.base_url }}/categories",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Lazer\",\n  \"type\": \"EXPENSE\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_categories_update",
      "parentId": "grp_categories",
      "name": "Atualizar categoria",
      "method": "PATCH",
      "url": "{{ _.base_url }}/categories/{{ _.category_id }}",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Mercado\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
