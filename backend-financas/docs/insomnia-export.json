      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_transactions_create",
      "parentId": "grp_transactions",
      "name": "Criar transação",
      "method": "POST",
      "url": "{{ _.base_url }}/transactions",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"type\": \"EXPENSE\",\n  \"amountCents\": 12590,\n  \"description\": \"Compra do mês\",\n  \"date\": \"2026-10-29T12:00:00.000Z\",\n  \"categoryId\": \"{{ _.category_id }}\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_transactions_list",
      "parentId": "grp_transactions",
      "name": "Listar transações",
      "method": "GET",
      "url": "{{ _.base_url }}/transactions",
      "parameters": [
        { "name": "type", "value": "EXPENSE", "disabled": true },
        {
          "name": "categoryId",
          "value": "{{ _.category_id }}",
          "disabled": true
        },
        {
          "name": "from",
          "value": "2026-10-01T00:00:00.000Z",
          "disabled": true
        },
        { "name": "to", "value": "2026-10-31T23:59:59.999Z", "disabled": true },
        { "name": "search", "value": "mercado", "disabled": true },
        { "name": "page", "value": "1" },
        { "name": "limit", "value": "20" },
        { "name": "sort", "value": "date" },
        { "name": "order", "value": "desc" }
      ],
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_transactions_get",
      "parentId": "grp_transactions",
      "name": "Consultar transação",
      "method": "GET",
      "url": "{{ _.base_url }}/transactions/{{ _.transaction_id }}",
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_transactions_update",
      "parentId": "grp_transactions",
      "name": "Atualizar transação",
      "method": "PATCH",
      "url": "{{ _.base_url }}/transactions/{{ _.transaction_id }}",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"amountCents\": 13990,\n  \"description\": \"Compra do mês atualizada\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_transactions_delete",
      "parentId": "grp_transactions",
      "name": "Excluir transação",
      "method": "DELETE",
      "url": "{{ _.base_url }}/transactions/{{ _.transaction_id }}",
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_summary",
      "parentId": "grp_summary",
      "name": "Resumo financeiro",
      "method": "GET",
      "url": "{{ _.base_url }}/summary",
      "parameters": [
        {
          "name": "from",
          "value": "2026-10-01T00:00:00.000Z",
          "disabled": true
        },
        { "name": "to", "value": "2026-10-31T23:59:59.999Z", "disabled": true }
      ],
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_summary_category",
      "parentId": "grp_summary",
      "name": "Resumo por categoria",
