    {
      "_id": "req_register",
      "parentId": "grp_auth",
      "name": "Registrar usuário",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/register",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria@example.com\",\n  \"password\": \"senha1234\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "_type": "request"
    },
    {
      "_id": "req_login",
      "parentId": "grp_auth",
      "name": "Login",
      "method": "POST",
      "url": "{{ _.base_url }}/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"demo@financas.local\",\n  \"password\": \"senha1234\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "_type": "request"
    },
    {
      "_id": "req_health",
      "parentId": "grp_system",
      "name": "Health check",
      "method": "GET",
      "url": "{{ _.base_url }}/health",
      "_type": "request"
    },
    {
      "_id": "req_me",
      "parentId": "grp_users",
      "name": "Obter usuário autenticado",
      "method": "GET",
      "url": "{{ _.base_url }}/users/me",
      "authentication": { "type": "bearer", "token": "{{ _.token }}" },
      "_type": "request"
    },
    {
      "_id": "req_categories_list",
      "parentId": "grp_categories",
      "name": "Listar categorias",
      "method": "GET",
